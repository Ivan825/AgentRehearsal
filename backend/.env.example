# Copy to .env and fill in. Never commit .env.

# AWS credentials are read the normal boto3 way (env vars, ~/.aws, or an assumed role).
AWS_REGION=us-east-1

# Model that plays the target agent (SupportBot). Small models fail attacks more often, which is the point.
AGENTREHEARSAL_TARGET_MODEL=us.amazon.nova-lite-v1:0

# Model that writes scenarios and one-line explanations. A stronger model is worth it here.
AGENTREHEARSAL_AUTHOR_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Where run JSON files are written
AGENTREHEARSAL_RUNS_DIR=runs

# Optional, Path B: AgentCore Gateway serving the same tools (see infra/README.md)
# AGENTREHEARSAL_GATEWAY_URL=https://<gateway-id>.gateway.bedrock-agentcore.us-east-1.amazonaws.com/mcp
# AGENTREHEARSAL_GATEWAY_TOKEN=
# AGENTREHEARSAL_GATEWAY_TARGET=SupportTools

# Storage: one DynamoDB table (pk, sk) created by scripts/create_tables.py; without it, JSON files under backend/data/
# AGENTREHEARSAL_DDB_TABLE=agentrehearsal

# Accounts: on by default. Set off for local development without sign-in (the CLI never needs it).
# AGENTREHEARSAL_AUTH=off
# AGENTREHEARSAL_JWT_SECRET=change-me-in-production

# Optional: pace the offline scripted model (seconds per model call) so a demo without AWS looks live
# AGENTREHEARSAL_SCRIPTED_DELAY=0.4
